<Window x:Class="DynamicIsland.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:DynamicIsland.App.Controls"
        Title="Dynamic Island"
        Width="560" Height="440"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ResizeMode="NoResize"
        Topmost="True"
        ShowInTaskbar="False"
        ShowActivated="False"
        FontFamily="Segoe UI Variable Text, Segoe UI">

    <Window.Resources>
        <Style x:Key="Card" TargetType="Border">
            <Setter Property="Background" Value="#2C2C2E"/>
        </Style>
        <Style x:Key="CardText" TargetType="TextBlock">
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>
        <Style x:Key="TabText" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#636366"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Margin" Value="12,0"/>
        </Style>
    </Window.Resources>

    <Grid>
        <Border x:Name="Notch"
                Background="Black"
                ClipToBounds="True"
                HorizontalAlignment="Center"
                VerticalAlignment="Top"
                MouseEnter="NotchMouseEnter"
                MouseLeave="NotchMouseLeave">
            <Grid>
                <!-- Konten selalu berukuran penuh; border yang membesar/mengecil
                 hanya "membuka" dan "menutup" area yang terlihat. -->
                <Grid x:Name="CompactContent"
      Height="32"
      VerticalAlignment="Top"
      Margin="16,0"
      IsHitTestVisible="False">
                    <controls:ActivitySlotView x:Name="LeftSlot"
                               HorizontalAlignment="Left"
                               VerticalAlignment="Center"/>
                    <controls:ActivitySlotView x:Name="RightSlot"
                               HorizontalAlignment="Right"
                               VerticalAlignment="Center"/>
                </Grid>
                <Grid x:Name="ExpandedContent"
                  Width="500" Height="380"
                  HorizontalAlignment="Center"
                  VerticalAlignment="Top"
                  Opacity="0" Visibility="Hidden">

                    <Grid Margin="22,14,22,22">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <!-- tabs -->
                            <RowDefinition Height="Auto"/>
                            <!-- tanggal + baterai -->
                            <RowDefinition Height="Auto"/>
                            <!-- wifi, bluetooth, audio -->
                            <RowDefinition Height="Auto"/>
                            <!-- volume -->
                            <RowDefinition Height="Auto"/>
                            <!-- brightness -->
                            <RowDefinition Height="*"/>
                            <!-- music player -->
                        </Grid.RowDefinitions>

                        <!-- Tabs -->
                        <StackPanel Grid.Row="0" Orientation="Horizontal" HorizontalAlignment="Center">
                            <TextBlock Text="Tabs 3" Style="{StaticResource TabText}"/>
                            <TextBlock Text="Tabs 1" Style="{StaticResource TabText}" Foreground="White"/>
                            <TextBlock Text="Tabs 2" Style="{StaticResource TabText}"/>
                        </StackPanel>

                        <!-- Tanggal kiri, baterai kanan -->
                        <Grid Grid.Row="1" Margin="0,8,0,0">
                            <TextBlock x:Name="DateText" Style="{StaticResource CardText}"
                                   FontSize="16" HorizontalAlignment="Left"/>
                            <StackPanel x:Name="BatteryPanel" Orientation="Horizontal"
                                    HorizontalAlignment="Right">
                                <TextBlock x:Name="BatteryText" Style="{StaticResource CardText}"
                                       Text="100%" Margin="0,0,10,0"/>
                                <controls:BatteryRing x:Name="Battery" Width="30" Height="30"/>
                            </StackPanel>
                        </Grid>

                        <!-- Wifi | Bluetooth | Audio device -->
                        <Grid Grid.Row="2" Margin="0,12,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <Border Grid.Column="0" Style="{StaticResource Card}"
                                CornerRadius="18" Height="64" Margin="0,0,5,0">
                                <TextBlock Text="Wifi" Style="{StaticResource CardText}" Margin="16,0"/>
                            </Border>
                            <Border Grid.Column="1" Style="{StaticResource Card}"
                                CornerRadius="18" Height="64" Margin="5,0">
                                <TextBlock Text="Bluetooth" Style="{StaticResource CardText}" Margin="16,0"/>
                            </Border>
                            <Border Grid.Column="2" Style="{StaticResource Card}"
                                CornerRadius="18" Height="64" Margin="5,0,0,0">
                                <TextBlock Text="Audio" Style="{StaticResource CardText}" Margin="16,0"/>
                            </Border>
                        </Grid>

                        <!-- Slider volume & brightness (placeholder) -->
                        <Border Grid.Row="3" Style="{StaticResource Card}"
                            CornerRadius="19" Height="38" Margin="0,10,0,0">
                            <TextBlock Text="Volume" Style="{StaticResource CardText}" Margin="16,0"/>
                        </Border>
                        <Border Grid.Row="4" Style="{StaticResource Card}"
                            CornerRadius="19" Height="38" Margin="0,10,0,0">
                            <TextBlock Text="Brightness" Style="{StaticResource CardText}" Margin="16,0"/>
                        </Border>

                        <!-- Music player (placeholder) -->
                        <Border Grid.Row="5" Style="{StaticResource Card}"
                            CornerRadius="26" Margin="0,10,0,0">
                            <TextBlock Text="Music Player" Style="{StaticResource CardText}"
                                   HorizontalAlignment="Center"/>
                        </Border>
                    </Grid>
                </Grid>
                <controls:WaterFill x:Name="Water"
                            Visibility="Collapsed"
                            IsHitTestVisible="False"/>

            </Grid>
        </Border>
    </Grid>

</Window>